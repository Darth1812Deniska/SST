<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SqlScriptToolAvalonia.MainWindow"
        Title="SqlScriptToolAvalonia"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
    <Grid RowDefinitions="Auto,Auto,*">
        <DockPanel Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Name="MiSettings" Header="Настройки" Click="MiSettings_OnClick"/>
            </Menu>
        </DockPanel>
        <Separator IsVisible="True" Grid.Row="1"></Separator>
        <Grid Grid.Row="2" RowDefinitions="*,*">
            <Button Grid.Row="0" Name="BtnGenScript" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center" Padding="15" Margin="5" Click="BtnGenScript_OnClick">
                <StackPanel Orientation="Horizontal">
                    <Image Height="30" Source="assets/pics/icon_gen_script.png" />
                    <TextBlock>Сгенерировать скрипт по выбранной модели</TextBlock>
                </StackPanel>

            </Button>
            <Button Grid.Row="1" Name="BtnConstructor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center" Padding="15" Margin="5" Click="BtnConstructor_OnClick">
                <StackPanel Orientation="Horizontal">
                    <Image Height="30" Source="assets/pics/icons_construct.png" />
                    <TextBlock>Конструктор моделей</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>