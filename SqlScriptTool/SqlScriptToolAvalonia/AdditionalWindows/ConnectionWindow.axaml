<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="SqlScriptToolAvalonia.AdditionalWindows.ConnectionWindow"
        Title="ConnectionWindow" Height="350" Width="500">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150px"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="150px"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="30px"/>
      <RowDefinition Height="30px"/>
      <RowDefinition Height="30px"/>
      <RowDefinition Height="30px"/>
      <RowDefinition Height="30px"/>
      <RowDefinition/>
    </Grid.RowDefinitions>

    <Label Grid.Column="0">Проект</Label>
    <ComboBox x:Name="CmbProjects" Grid.Row="0" Grid.Column="1" IsEditable="True" Margin="0,3"/>

    <Label Grid.Column="0" Grid.Row="1">Тип СУБД</Label>
    <ComboBox x:Name="CmbDbType" Grid.Column="1" Grid.Row="1" SelectionChanged="ComboBox_SelectionChanged" Margin="0,3">
      <ComboBoxItem Content="PostgreSQL"/>
      <ComboBoxItem Content="MSSQL"/>
    </ComboBox>

    <Label Grid.Column="0" Grid.Row="2">Стенд (IP адрес)</Label>
    <ComboBox x:Name="CmbAddress" Grid.Column="1" Grid.Row="2" Margin="0,3" IsEditable="True"/>

    <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
      <Label>Порт</Label>
      <TextBox x:Name="TbPort" Width="70px" Height="24"/>
    </StackPanel>

    <Label Grid.Column="0" Grid.Row="3">Название БД</Label>
    <TextBox x:Name="TbDbName" Grid.Column="1" Grid.Row="3" Margin="0,3"/>

    <Label Grid.Column="0" Grid.Row="4">Краткое наименование</Label>
    <TextBox x:Name="TbShortName" Grid.Column="1" Grid.Row="4" Margin="0,3"/>

    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
      <StackPanel Orientation="Horizontal">
        <Label Width="60">Логин</Label>
        <TextBox x:Name="TbLogin" Width="150px" Height="24" HorizontalAlignment="Left"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal">
        <Label Width="60">Пароль</Label>
        <PasswordBox x:Name="PbPassInput" Width="150px" Height="24" HorizontalAlignment="Left"/>
      </StackPanel>

      <Button x:Name="BtnCheckConnection" Width="250px" HorizontalAlignment="Left" Margin="0,10,0,0" Height="30" Click="CheckConnectionBtn_Click">Проверить соединение</Button>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="BtnSave" Width="120px" HorizontalAlignment="Left" Height="30">Сохранить</Button>
        <Button x:Name="BtnCancel" Width="120px" HorizontalAlignment="Left" Height="30" Margin="10,0,0,0" Click="BtnCancel_Click">Отмена</Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
