<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="350"
        x:Class="SqlScriptToolAvalonia.ConstructorWindows.TagEditorWindow"
        Title="Редактор тэгов" Height="350" Width="750" WindowStartupLocation="CenterScreen"
        MinWidth="750" MinHeight="350">
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

            <Label Grid.Column="0" Grid.Row="0">Название</Label>
            <Label Grid.Column="0" Grid.Row="1">Отображаемое название</Label>
            <Label Grid.Column="0" Grid.Row="2">Описание</Label>
            <Label Grid.Column="0" Grid.Row="3">Uuid</Label>
            <Label Grid.Column="0" Grid.Row="5">Тип тэга</Label>
            <Label Grid.Column="0" Grid.Row="6">Тип пользовательского параметра</Label>
            <Label Grid.Column="0" Grid.Row="7" IsEnabled="False" IsVisible="False">Тип объекта LD</Label>
            <Label Grid.Column="0" Grid.Row="8">SQL шаблон</Label>

            <TextBox x:Name="TbName" Grid.Column="1" Grid.Row="0" Margin="2"></TextBox>
            <TextBox x:Name="TbDisplayLabel" Grid.Column="1" Grid.Row="1" Margin="2"></TextBox>
            <TextBox x:Name="TbDescription" Grid.Column="1" Grid.Row="2" Margin="2"></TextBox>
            <TextBox x:Name="TbUuid" Grid.Column="1" Grid.Row="3" Margin="2" IsReadOnly="True"></TextBox>
            <CheckBox x:Name="CbMultiplePattern" Grid.Column="1" Grid.Row="4" Margin="2" Content="Множественный шаблон"
                      Checked="cbMultiplePattern_Checked" Unchecked="cbMultiplePattern_Checked"/>
            <Grid Grid.Column="1" Grid.Row="5" Margin="2" RowDefinitions="*,*,*,*,*">

                <RadioButton x:Name="RbUserParameter" Grid.Row="0" GroupName="TagTypeRbGroup"
                             Content="Пользовательский параметр"/>
                <RadioButton x:Name="RbModelItemParent" Grid.Row="1" GroupName="TagTypeRbGroup" Content="SQL шаблон"/>
                <RadioButton x:Name="RbCalculatedValue" Grid.Row="2" GroupName="TagTypeRbGroup"
                             Content="Вычисляемое значение"/>
                <RadioButton x:Name="RbConstant" Grid.Row="3" GroupName="TagTypeRbGroup" Content="Константа"/>
            </Grid>
            <ComboBox x:Name="CmbDataType" Grid.Column="1" Grid.Row="6" Margin="2"/>
            <ComboBox x:Name="CmbLdObjectType" Grid.Column="1" Grid.Row="7" Margin="2" IsEnabled="False"
                      IsVisible="False"></ComboBox>
            <ComboBox x:Name="CmbSqlTemplate" Grid.Column="1" Grid.Row="8" Margin="2"
                      SelectionChanged="CmbSqlTemplate_SelectionChanged">
            </ComboBox>
            <Button x:Name="BtnOpenCreate" Grid.Row="8" Grid.Column="2" Margin="2" Padding="10,0"
                    Content="Открыть / Создать шаблон" Click="BtnOpenCreate_Click"/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto">
            <Button Grid.Column="3" Padding="10,5" Margin="5" x:Name="BtnCancel" Click="BtnCancel_Click">Отменить</Button>
            <Button Grid.Column="2" Padding="10,5" Margin="5" x:Name="BtnSaveAndClose" Click="BtnSaveAndClose_Click">
                Сохранить и закрыть</Button>
            <Button Grid.Column="1" Padding="10,5" Margin="5" x:Name="BtnSave" Click="BtnSave_Click">Сохранить</Button>
        </Grid>
    </Grid>
</Window>
