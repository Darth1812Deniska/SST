<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
        x:Class="SqlScriptToolAvalonia.ConstructorForms.SqlTemplateEditorWindow"
        Title="Редактор SQL-шаблонов" Height="550" Width="800" WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Label Grid.Column="0" Grid.Row="0">Название</Label>
            <Label Grid.Column="0" Grid.Row="1">Отображаемое наименовение</Label>
            <Label Grid.Column="0" Grid.Row="2">Описание шаблона</Label>
            <Label Grid.Column="0" Grid.Row="3">Uid</Label>
            <Label Grid.Column="0" Grid.Row="5">Тип СУБД</Label>
            <TextBox x:Name="TbName" Grid.Column="1" Grid.Row="0" Margin="2"></TextBox>
            <TextBox x:Name="TbDisplayLabel" Grid.Column="1" Grid.Row="1" Margin="2"></TextBox>
            <TextBox x:Name="TbDescription" Grid.Column="1" Grid.Row="2" Margin="2"></TextBox>
            <TextBox x:Name="TbUuid" Grid.Column="1" Grid.Row="3" Margin="2" IsReadOnly="True"></TextBox>
            <CheckBox x:Name="ChbIsMultiplePattern" Grid.Column="1" Grid.Row="4" Margin="2" Content="Множественный шаблон"/>
            <Grid Grid.Column="1" Grid.Row="5" RowDefinitions="Auto,Auto">
                <RadioButton x:Name="RbPostgreSql" Grid.Row="0" GroupName="DbmsType" Content="PostgreSQL"/>
                <RadioButton x:Name="RbMsSql" Grid.Row="1" GroupName="DbmsType" Content="MS SQL"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="3*,2*,2*">
            <TextBox x:Name="TbCodeEditor" Margin="10,10,10,0" Grid.Column="0" TextChanged="TbCodeEditor_TextChanged"
                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"/>
            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                    <Label Grid.Row="0" VerticalAlignment="Top">Шаблоны</Label>
                    <ListBox x:Name="LbTemplateTags" Grid.Row="1" Margin="10,0,10,0"/>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <Label Grid.Row="0">Текущие</Label>
                    <ListBox x:Name="LbNodeTags" Grid.Row="1" Margin="10,0,10,0"
                             SelectionChanged="LbNodeTags_SelectionChanged">
                    </ListBox>
                </Grid>
            </Grid>
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <Label Grid.Row="0">Предпросмотр тэга:</Label>
                <TextBlock x:Name="TbTagPreview" Grid.Row="1" TextWrapping="Wrap"></TextBlock>
                <Button x:Name="BtnTagEdit" Grid.Row="2" Padding="10,5" Margin="5" Click="BtnTagEdit_Click">
                    Редактировать</Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto">
            <Button Grid.Column="3" Padding="10,5" Margin="5" x:Name="BtnCancel" Click="BtnCancel_Click">Отменить</Button>
            <Button Grid.Column="2" Padding="10,5" Margin="5" x:Name="BtnSaveAndClose" Click="BtnSaveAndClose_Click">
                Сохранить и закрыть</Button>
            <Button Grid.Column="1" Padding="10,5" Margin="5" x:Name="BtnSave" Click="BtnSave_Click">Сохранить</Button>
        </Grid>
    </Grid>
</Window>
