<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SqlScriptToolAvalonia.GeneratorWindows.ModelGenerationListWindow"
        Title="ModelGenerationListWindow">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0" Margin="20,0" Orientation="Horizontal">
            <RadioButton GroupName="DbType" Content="Все" Name="RbAllDbType" IsChecked="True" Tag="All"
                         IsCheckedChanged="RbDbType_OnIsCheckedChanged" />
            <RadioButton GroupName="DbType" Content="Postgres" Name="RbPgDbType" Tag="Pg"
                         IsCheckedChanged="RbDbType_OnIsCheckedChanged" />
            <RadioButton GroupName="DbType" Content="MsSQL" Name="RbMsSqlDbType" Tag="Ms"
                         IsCheckedChanged="RbDbType_OnIsCheckedChanged" />
        </StackPanel>
        <DataGrid Grid.Row="1" Margin="20"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  BorderThickness="1" BorderBrush="Gray"
                  Name="DgModels" />
    </Grid>
</Window>