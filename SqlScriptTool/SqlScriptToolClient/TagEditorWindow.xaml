<Window x:Name="WindowTagEditor" x:Class="SqlScriptToolClient.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlScriptToolClient"
        mc:Ignorable="d"
        Title="Редактор тэгов" Height="372" Width="750" WindowStartupLocation="CenterScreen" MinWidth="750" MinHeight="372">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="525*"/>
            <ColumnDefinition Width="193*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Grid.Row="0">Название</Label>
            <Label Grid.Column="0" Grid.Row="1">Отображаемое название</Label>
            <Label Grid.Column="0" Grid.Row="2">Описание</Label>
            <Label Grid.Column="0" Grid.Row="3">Uuid</Label>
            <Label Grid.Column="0" Grid.Row="4">Тип тэга</Label>
            <Label Grid.Column="0" Grid.Row="5">Тип пользовательского параметра</Label>
            <Label Grid.Column="0" Grid.Row="6" IsEnabled="False">Тип объекта LD</Label>
            <Label Grid.Column="0" Grid.Row="7">SQL шаблон</Label>

            <TextBox x:Name="TbName" Grid.Column="1" Grid.Row="0" Margin="2"></TextBox>
            <TextBox x:Name="TbDisplayLabel" Grid.Column="1" Grid.Row="1" Margin="2"></TextBox>
            <TextBox x:Name="TbDescription" Grid.Column="1" Grid.Row="2" Margin="2"></TextBox>
            <TextBox x:Name="TbUuid" Grid.Column="1" Grid.Row="3" Margin="2" IsReadOnly="True" TextChanged="TbUuid_TextChanged"></TextBox>
            <Grid Grid.Column="1" Grid.Row="4" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <CheckBox x:Name="cbMultiplePattern" Grid.Row="0" Content="Множественный шаблон" Checked="cbMultiplePattern_Checked" Unchecked="cbMultiplePattern_Checked"/>
                <RadioButton x:Name="RbUserParameter" Grid.Row="1"  GroupName="TagTypeRbGroup" >Пользовательский параметр</RadioButton>
                <RadioButton x:Name="RbModelItemParent" Grid.Row="2" GroupName="TagTypeRbGroup" AutomationProperties.ItemStatus="" >SQL шаблон</RadioButton>
                <RadioButton x:Name="RbCalculatedValue" Grid.Row="3" GroupName="TagTypeRbGroup" >Вычисляемое значение</RadioButton>
                <RadioButton x:Name="RbConstant" Grid.Row="4" GroupName="TagTypeRbGroup" >Константа</RadioButton>


            </Grid>
            <ComboBox x:Name="CmbDataType" Grid.Column="1" Grid.Row="5" Margin="2"/>
            <ComboBox x:Name="CmbLdObjectType" Grid.Column="1" Grid.Row="6" Margin="2" IsEnabled="False"></ComboBox>
            <ComboBox x:Name="CmbSqlTemplate" Grid.Column="1" Grid.Row="7" Margin="2"></ComboBox>


        </Grid>
        <Grid Grid.ColumnSpan="2" Margin="0,281,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Padding="10,5" Margin="0,11,10,0" x:Name="BtnCancel" Click="BtnCancel_Click" Width="120" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="30">Отменить</Button>
            <Button Padding="10,5" Margin="0,11,156,0" x:Name="BtnSave" Click="BtnSave_Click" Width="120" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="30">Сохранить</Button>
        </Grid>
        <Button x:Name="btnOpenCreate" Grid.Column="1" Content="Открыть / Создать шаблон" HorizontalAlignment="Center" Margin="0,227,0,0" VerticalAlignment="Top" Width="181" Height="32"/>

    </Grid>
</Window>