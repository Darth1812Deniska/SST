<Window x:Name="WindowTagEditor" x:Class="SqlScriptToolClient.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlScriptToolClient"
        mc:Ignorable="d"
        Title="Редактор тэгов" Height="340" Width="750" WindowStartupLocation="CenterScreen" MinWidth="750" MinHeight="340">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Grid.Row="0">Название</Label>
            <Label Grid.Column="0" Grid.Row="1">Отображаемое название</Label>
            <Label Grid.Column="0" Grid.Row="2">Описание</Label>
            <Label Grid.Column="0" Grid.Row="3">Uuid</Label>
            <Label Grid.Column="0" Grid.Row="5">Тип тэга</Label>
            <Label Grid.Column="0" Grid.Row="6">Тип пользовательского параметра</Label>
            <Label Grid.Column="0" Grid.Row="7" IsEnabled="False">Тип объекта LD</Label>
            <Label Grid.Column="0" Grid.Row="8">SQL шаблон</Label>

            <TextBox x:Name="TbName" Grid.Column="1" Grid.Row="0" Margin="2"></TextBox>
            <TextBox x:Name="TbDisplayLabel" Grid.Column="1" Grid.Row="1" Margin="2"></TextBox>
            <TextBox x:Name="TbDescription" Grid.Column="1" Grid.Row="2" Margin="2"></TextBox>
            <TextBox x:Name="TbUuid" Grid.Column="1" Grid.Row="3" Margin="2" IsReadOnly="True"></TextBox>
            <CheckBox x:Name="CbMultiplePattern" Grid.Column="1" Grid.Row="4" Margin="2" Content="Множественный шаблон" Checked="cbMultiplePattern_Checked" Unchecked="cbMultiplePattern_Checked"/>
            <Grid Grid.Column="1" Grid.Row="5" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <RadioButton x:Name="RbUserParameter" Grid.Row="0"  GroupName="TagTypeRbGroup" >Пользовательский параметр</RadioButton>
                <RadioButton x:Name="RbModelItemParent" Grid.Row="1" GroupName="TagTypeRbGroup"  >SQL шаблон</RadioButton>
                <RadioButton x:Name="RbCalculatedValue" Grid.Row="2" GroupName="TagTypeRbGroup" >Вычисляемое значение</RadioButton>
                <RadioButton x:Name="RbConstant" Grid.Row="3" GroupName="TagTypeRbGroup" >Константа</RadioButton>
            </Grid>
            <ComboBox x:Name="CmbDataType" Grid.Column="1" Grid.Row="6" Margin="2"/>
            <ComboBox x:Name="CmbLdObjectType" Grid.Column="1" Grid.Row="7" Margin="2" IsEnabled="False"></ComboBox>
            <ComboBox x:Name="CmbSqlTemplate" Grid.Column="1" Grid.Row="8"  Margin="2"></ComboBox>
            <Button x:Name="BtnOpenCreate" Grid.Row="8" Grid.Column="2"  Margin="2" Padding="10,0" Content="Открыть / Создать шаблон" />
        </Grid>
        <Grid Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" Padding="10,5" Margin="5" x:Name="BtnCancel" Click="BtnCancel_Click" Width="120" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="30">Отменить</Button>
            <Button Grid.Column="1" Padding="10,5" Margin="5" x:Name="BtnSave" Click="BtnSave_Click" Width="120" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="30">Сохранить</Button>
        </Grid>
    </Grid>
</Window>