<Window x:Class="SqlScriptToolClient.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlScriptToolClient"
        mc:Ignorable="d"
        Title="TagEditorWindow" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <Label Grid.Column="0" Grid.Row="0">Название</Label>
            <Label Grid.Column="0" Grid.Row="1">Отображаемое название</Label>
            <Label Grid.Column="0" Grid.Row="2">Описание</Label>
            <Label Grid.Column="0" Grid.Row="3">Тип тэга</Label>
            <Label Grid.Column="0" Grid.Row="4">Тип пользовательского параметра</Label>
            <Label Grid.Column="0" Grid.Row="5">Тип объекта LD</Label>
            <Label Grid.Column="0" Grid.Row="6">SQL шаблон</Label>

            <TextBox Grid.Column="1" Grid.Row="0" Margin="2"></TextBox>
            <TextBox Grid.Column="1" Grid.Row="1" Margin="2"></TextBox>
            <TextBox Grid.Column="1" Grid.Row="2" Margin="2"></TextBox>
            <Grid Grid.Column="1" Grid.Row="3" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RadioButton Grid.Row="0" ></RadioButton>
                <RadioButton Grid.Row="1" ></RadioButton>
                <RadioButton Grid.Row="2" ></RadioButton>
                <RadioButton Grid.Row="3" ></RadioButton>
                <RadioButton Grid.Row="4" ></RadioButton>
                

            </Grid>
            <ComboBox Grid.Column="1" Grid.Row="4" Margin="2"></ComboBox>
            <ComboBox Grid.Column="1" Grid.Row="5" Margin="2"></ComboBox>
            <ComboBox Grid.Column="1" Grid.Row="6" Margin="2"></ComboBox>
            

        </Grid>
        <Grid Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" Padding="10,5" Margin="5" x:Name="BtnCancel">Отменить</Button>
            <Button Grid.Column="1" Padding="10,5" Margin="5" x:Name="BtnSave">Сохранить</Button>
        </Grid>

    </Grid>
</Window>