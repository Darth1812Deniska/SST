<Window x:Class="SqlScriptToolClient.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlScriptToolClient"
        mc:Ignorable="d"
        Title="ConnectionWindow" Height="350" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150px"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150px"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30px"></RowDefinition>
            <RowDefinition Height="30px"></RowDefinition>
            <RowDefinition Height="30px"></RowDefinition>
            <RowDefinition Height="30px"></RowDefinition>
            <RowDefinition Height="30px"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Column="0">Проект</Label>
        <ComboBox Grid.Column="1" Width="150px" Height="20px" HorizontalAlignment="Left" Margin="0,5,0,5" IsEditable="True"/>

        <Label Grid.Column="0" Grid.Row="1">Тип СУБД</Label>
        <ComboBox x:Name="DBType" Grid.Column="1" Grid.Row="1" Width="150px" Height="20px" HorizontalAlignment="Left" Margin="0,5,0,5" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem Content="PostgreSQL" IsSelected="True"/>
            <ComboBoxItem Content="MSSQL"/>
        </ComboBox>

        <Label Grid.Column="0" Grid.Row="2">Стенд (IP адрес)</Label>
        <ComboBox x:Name="address"  Grid.Column="1" Grid.Row="2" Width="150px" Height="20px" HorizontalAlignment="Left" Margin="0,5,0,5" IsEditable="True"/>

        <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal">
            <Label >Порт</Label>
            <TextBox x:Name="port" Grid.Column="1" Grid.Row="2" Width="70px" Height="20px" HorizontalAlignment="Left" Initialized="port_Initialized"/>
        </StackPanel>

        <Label Grid.Column="0" Grid.Row="3">Название БД</Label>
        <TextBox x:Name="dbName" Grid.Column="1" Grid.Row="3" Width="150px" Height="20px" HorizontalAlignment="Left"/>

        <Label Grid.Column="0" Grid.Row="4">Краткое наименование</Label>
        <TextBox Grid.Column="1" Grid.Row="4" Width="150px" Height="20px" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <Label Width="50px">Логин</Label>
                <TextBox x:Name="login" Width="150px" Height="20px" HorizontalAlignment="Left"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Width="50px">Пароль</Label>
                <PasswordBox x:Name="password" Width="150px" Height="20px" HorizontalAlignment="Left"/>
            </StackPanel>

            <Button x:Name="checkConnectionBtn" Width="250px" HorizontalAlignment="Left" Margin="0,10,0,0" Height="30" Click="checkConnectionBtn_Click">Проверить соединение</Button>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Width="120px" HorizontalAlignment="Left"  Height="30">Сохранить</Button>
                <Button Width="120px" HorizontalAlignment="Left"  Height="30" Margin="10,0,0,0">Отмена</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
