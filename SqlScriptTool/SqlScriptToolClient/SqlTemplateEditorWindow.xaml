<Window x:Class="SqlScriptToolClient.SqlTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlScriptToolClient"
        mc:Ignorable="d"
        Title="SqlTemplateEditorWindow" Height="550" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Grid.Row="0">Название</Label>
            <Label Grid.Column="0" Grid.Row="1">Отображаемое наименовение</Label>
            <Label Grid.Column="0" Grid.Row="2">Описание шаблона</Label>
            <Label Grid.Column="0" Grid.Row="3">Uid</Label>
            <Label Grid.Column="0" Grid.Row="4">Тип СУБД</Label>
            <TextBox x:Name="tbName" Grid.Column="1" Grid.Row="0" Margin="2"></TextBox>
            <TextBox x:Name="tbDisplayLabel" Grid.Column="1" Grid.Row="1" Margin="2"></TextBox>
            <TextBox x:Name="tbDescription" Grid.Column="1" Grid.Row="2" Margin="2"></TextBox>
            <TextBox x:Name="tbUuid" Grid.Column="1" Grid.Row="3" Margin="2"></TextBox>
            <Grid Grid.Column="1" Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <RadioButton x:Name="RbPostgreSql" Grid.Row="0" GroupName="DbmsType">PostgreSQL</RadioButton>
                <RadioButton x:Name="RbMsSql" Grid.Row="1" GroupName="DbmsType">MS SQL</RadioButton>
            </Grid>

        </Grid>
        <Grid Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TbCodeEditor" Margin="10" Grid.Column="0"></TextBox>
            <Grid Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ListBox x:Name="LbTemplateTags" Grid.Row="0" Margin="10"></ListBox>
                <ListBox x:Name="LbNodeTags" Grid.Row="1" Margin="10"></ListBox>
            </Grid>
            <Grid Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0">Предпросмотр тэга:</Label>
                <TextBlock x:Name="TbTagPreview" Grid.Row="1"></TextBlock>
                <Button x:Name="BtnTagEdit" Grid.Row="2" Padding="10,5" Margin="5">Редактировать</Button>
            </Grid>
        </Grid>

        <Grid Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" Padding="10,5" Margin="5" x:Name="BtnCancel">Отменить</Button>
            <Button Grid.Column="1" Padding="10,5" Margin="5" x:Name="BtnSave">Сохранить</Button>
        </Grid>
    </Grid>
</Window>