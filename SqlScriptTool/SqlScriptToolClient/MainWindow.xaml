<Window x:Class="SqlScriptToolClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlScriptToolClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="450" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" >
            <Button x:Name="BtnCreateNewModel" Margin="5" Padding="3" Click="BtnCreateNewModel_Click" >Создать новую Модель</Button>
            <Button x:Name="BtnCreateNewSqlTemplate" Margin="5" Padding="3" Click="BtnCreateNewSqlTemplate_Click" >Создать новый SQL-шаблон</Button>
            <Button x:Name="BtnCreateNewTag" Margin="5" Padding="3" Click="BtnCreateNewTag_Click" >Создать новый тэг</Button>
        </StackPanel>
        <Grid Grid.Row="0" Column="1">
            <Button Margin="20">Сгенерировать скрипт</Button>
        </Grid>
    </Grid>
</Window>